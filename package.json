{
  "name": "servicecall-desktop",
  "version": "1.0.0",
  "description": "ServiceCall Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.servicecall.desktop",
    "productName": "ServiceCall Desktop",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "call-window.html",
      "call-window.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ServiceCall Desktop"
    }
  }
}